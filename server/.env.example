# Copy to server/.env and fill in. Never commit server/.env.
NODE_ENV=development
# 5000 is taken by macOS AirPlay Receiver, so the API uses 5050.
PORT=5050

# Local MongoDB (Homebrew). For Atlas use: mongodb+srv://<user>:<password>@<cluster-host>/ai-mystery-room
MONGODB_URI=mongodb://127.0.0.1:27017/ai-mystery-room

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters

CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Set MOCK_GEMINI=true to develop without an API key (deterministic fixture cases).
MOCK_GEMINI=true
# Get a key at https://aistudio.google.com/apikey . Server-only; never commit it.
GEMINI_API_KEY=
# Model names change often; list yours with:
#   curl -s -H "x-goog-api-key: $GEMINI_API_KEY" https://generativelanguage.googleapis.com/v1beta/models | grep '"name"'
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_VALIDATOR_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TEXT_TIMEOUT_MS=120000
# Max simultaneous Gemini requests across all cases (keeps under free-tier per-minute limits).
GEMINI_MAX_CONCURRENT_CALLS=3
# AI images need a paid (billing-enabled) key; the free tier allows 0 images/day.
ENABLE_IMAGE_GENERATION=false
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
ENABLE_VIDEO_GENERATION=false

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

GENERATION_CONCURRENCY=2
MAX_GENERATIONS_PER_DAY_USER=10
MAX_GENERATIONS_PER_DAY_GUEST=3
